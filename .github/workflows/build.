name: Setup Vosk Model and Build APK

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Download and Setup Vosk Model
        run: |
          mkdir -p app/src/main/assets
          cd app/src/main/assets
          if [ ! -d "model-en" ]; then
            echo "Downloading Vosk model..."
            curl -L -O https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
            unzip vosk-model-small-en-us-0.15.zip
            mv vosk-model-small-en-us-0.15 model-en
            rm vosk-model-small-en-us-0.15.zip
          fi

      - name: Build Debug APK
        run: gradle assembleDebug

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: MAX-assistant-app
          path: app/build/outputs/apk/debug/app-debug.apk
